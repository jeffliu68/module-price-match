<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="magentoguy.pricematch.customer.list"
                   template="MagentoGuy_PriceMatch::customer/requests.phtml" cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">MagentoGuy\PriceMatch\ViewModel\CustomerRequests</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
