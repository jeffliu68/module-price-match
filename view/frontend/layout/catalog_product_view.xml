<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.main">
            <block class="Magento\Catalog\Block\Product\View" name="magentoguy.pricematch.button"
                   template="MagentoGuy_PriceMatch::product/price-match.phtml" after="product.info.price">
                <arguments>
                    <argument name="view_model" xsi:type="object">MagentoGuy\PriceMatch\ViewModel\ProductPriceMatch</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
