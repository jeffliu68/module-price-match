<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::marketing">
                    <resource id="MagentoGuy_PriceMatch::price_match" title="Price Match" translate="title" sortOrder="60">
                        <resource id="MagentoGuy_PriceMatch::requests" title="View Requests" translate="title" sortOrder="10"/>
                        <resource id="MagentoGuy_PriceMatch::review" title="Approve / Reject Requests" translate="title" sortOrder="20"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="MagentoGuy_PriceMatch::config" title="Price Match Settings" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
