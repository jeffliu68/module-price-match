<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_before">
        <observer name="magentoguy_pricematch_reserve_coupon" instance="MagentoGuy\PriceMatch\Observer\ReserveCouponObserver"/>
    </event>
    <event name="sales_model_service_quote_submit_failure">
        <observer name="magentoguy_pricematch_release_coupon" instance="MagentoGuy\PriceMatch\Observer\ReleaseCouponObserver"/>
    </event>
    <event name="sales_model_service_quote_submit_success">
        <observer name="magentoguy_pricematch_confirm_coupon" instance="MagentoGuy\PriceMatch\Observer\ConfirmCouponObserver"/>
    </event>
</config>
