<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="magentoguy_pricematch_requeue" instance="MagentoGuy\PriceMatch\Cron\RequeueDueRequests" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="magentoguy_pricematch_expire" instance="MagentoGuy\PriceMatch\Cron\ExpireApprovedRequests" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
    </group>
</config>
